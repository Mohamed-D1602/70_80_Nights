# Copy this file to .env and fill in the values.

# Password for the admin page (/admin). Required: the admin page stays locked if empty.
ADMIN_PASSWORD=change-me

# Secret used to sign admin sessions. Any long random string.
# If empty, a random one is generated at startup (admins are logged out on restart).
SESSION_SECRET=

# Port the server listens on.
PORT=3000

# Folder where the song database (db.json) is stored.
# On hosting platforms, point this at a persistent disk/volume.
DATA_DIR=./data
